\ProvidesPackage{synaplot-labels}[2026/08/31 synaplot labels]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The text a layer writes around itself, its caption and the filter count under
% each box it draws, and the one measurement the writer needs back: how far
% across the page TikZ draws a unit of depth.
%
% A caption is written by the diagram rather than by the pic it belongs to,
% because where it goes depends on the whole row: every caption in a row hangs
% from the lowest point any layer of that row reached. PlotNeuralNet places
% each caption under its own layer, which leaves the captions of a shrinking
% stack of feature maps at different heights.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\makeatletter
% One unit of depth, drawn as this many centimetres across the page. TikZ
% projects the depth axis diagonally, so a layer drawn as a volume reaches
% further to each side than its width, and two of them chained together need
% room for both. The projection is read from the picture's own z axis rather
% than written down here, so a document that changes that axis still gets its
% layers spaced correctly.
\newcommand{\syDepthSlant}{(-\the\pgf@zx)/1cm}

\newlength{\syCaptionDrop}
\setlength{\syCaptionDrop}{4mm}
\newlength{\syCaptionWidth}
\setlength{\syCaptionWidth}{3cm}

% \syRowBase{<coordinate to name>}{<comma-separated layer names>}
%
% Names a coordinate on the lowest point that any of those layers drew, size
% labels included. It is read from the drawing rather than worked out in
% advance, because how far a label reaches depends on how wide its text sets,
% which only TeX knows.
\newcommand{\syRowBase}[2]{%
    \gdef\sy@low{}%
    \foreach \sy@n in {#2}{%
        \pgfextracty{\pgf@ya}{\pgfpointanchor{syExtent-\sy@n}{south}}%
        \ifx\sy@low\@empty
            \xdef\sy@low{\the\pgf@ya}%
        \else
            \ifdim\pgf@ya<\sy@low\relax \xdef\sy@low{\the\pgf@ya}\fi
        \fi}%
    \coordinate (#1) at (0,\sy@low);}

% \syCaption{<layer name>}{<row baseline coordinate>}{<text>}
%
% Writes one caption under one layer, hanging from the line its row shares, so
% that a row of captions reads as a line however tall each layer is drawn.
\newcommand{\syCaption}[3]{%
    \node[anchor=north, yshift=-\syCaptionDrop, text width=\syCaptionWidth,
          align=center, inner sep=0pt]
         at (syExtent-#1.center |- #2) {\textcolor{black}{\bf #3}};}

\newlength{\syLegendInset}
\setlength{\syLegendInset}{4mm}
\newlength{\sy@legendy}

% \syLegendItem{<fill>}{<opacity>}{<label>}
%
% One row of a legend: a swatch of the colour a layer is filled with, and the
% name of what that colour stands for. Rows are set as a table, so that the
% names line up however wide each swatch's neighbour is.
\newcommand{\syLegendItem}[3]{%
    \tikz[baseline=-0.55ex]{%
        \draw[fill=#1, fill opacity=#2, draw=black, line width=0.15mm]
            (0,0) rectangle (0.42,0.28);} & #3 \\}

% \syLegend{<corner of the drawing>}{<corner of the key>}{<step>}{<rows>}
%
% Draws the rows against one corner of the finished drawing, just clear of it
% rather than over it, so that a corner holding part of the diagram is not
% covered. Both corners are TikZ anchors: the key's is the drawing's flipped
% top for bottom, and the step says which way that is, so the gap of
% \syLegendInset is left in the right direction.
\newcommand{\syLegend}[4]{%
    \setlength{\sy@legendy}{#3\syLegendInset}%
    \node[anchor=#2, yshift=\sy@legendy,
          draw=black, line width=0.15mm, rounded corners=2pt,
          fill=white, fill opacity=0.85, text opacity=1, inner sep=4pt]
        at (current bounding box.#1)
        {\begin{tabular}{@{}c@{\ }l@{}}#4\end{tabular}};}

% \syFilterLabel{<left coordinate>}{<right coordinate>}{<box width in cm>}
%
% Writes \sy@xlabel under the bottom edge of one box. A label wider than the
% box is turned on its side, so that the labels of two boxes drawn side by side
% do not run together as one number. 2pt of that width is kept as the gap
% between one label and the next.
%
% A box standing on its own keeps its label upright, whatever its width, since
% there is nothing beside it to run into. \sy@boxcount says how many boxes the
% layer draws.
\newsavebox{\sy@labelbox}
\newcommand{\syFilterLabel}[3]{%
    % A picture selects a font that measures as nothing, so the label is set in
    % an interrupted picture to measure it, and set globally, because the
    % interruption opens a group a local box would not survive.
    \pgfinterruptpicture
        \global\setbox\sy@labelbox\hbox{\sy@xlabel}%
    \endpgfinterruptpicture
    \@tempswafalse
    \ifnum\sy@boxcount>1
        \ifdim\wd\sy@labelbox>\dimexpr#3cm-2pt\relax \@tempswatrue \fi
    \fi
    \if@tempswa
        \path (#1) -- (#2)
            node[midway, rotate=90, anchor=east, inner sep=2pt] {\sy@xlabel};
    \else
        \path (#1) edge ["\sy@xlabel"',midway] (#2);
    \fi}
\makeatother
