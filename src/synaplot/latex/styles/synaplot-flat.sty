\ProvidesPackage{synaplot-flat}[2026/08/31 synaplot flat pics]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Flat shapes, for architectures that are not drawn as stacks of feature maps.
%
% NodeLayer draws a column of circles, the way a plain neural network is
% usually shown. FlatBlock draws a rounded rectangle holding a line of text,
% the way the parts of a transformer or a recurrent cell are usually shown.
%
% These are new in synaplot. The 3D pics it inherited from PlotNeuralNet draw
% feature maps as volumes, which suits a convolutional network and nothing else.
%
% Every macro is prefixed \sy@ so that loading this package changes nothing in
% the document around it.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\makeatletter
\tikzset{
    NodeLayer/.pic={\tikzset{/synaplot/nodelayer/.cd,#1}

        \pgfmathsetmacro{\sy@noderadius}{\sy@radius*\sy@scale}
        \pgfmathsetmacro{\sy@nodestep}{\sy@spacing*\sy@scale}
        % The column is centred on the axis, so a row of layers lines up
        % however many nodes each one has.
        \pgfmathsetmacro{\sy@nodetop}{(\sy@count-1)*\sy@nodestep/2}

        \foreach \sy@n in {1,...,\sy@count} {
            \pgfmathsetmacro{\sy@nodey}{\sy@nodetop-(\sy@n-1)*\sy@nodestep}
            \node[circle, draw, line width=0.3mm,
                  fill=\sy@fill, fill opacity=\sy@opacity, text opacity=1,
                  minimum size=2*\sy@noderadius cm, inner sep=0pt]
                 (\sy@name-\sy@n) at (0,\sy@nodey) {};
        }

        % A break stands in for the nodes a large layer does not draw.
        \ifx\sy@break\@empty\else
            \pgfmathsetmacro{\sy@breaky}{\sy@nodetop-(\sy@break-0.5)*\sy@nodestep}
            \node[inner sep=0pt] at (0,\sy@breaky) {\vdots};
        \fi

        \coordinate (\sy@name-anchor) at (0,0);
        \coordinate (\sy@name-west)   at (-\sy@noderadius,0);
        \coordinate (\sy@name-east)   at ( \sy@noderadius,0);
        \coordinate (\sy@name-north)  at (0, \sy@nodetop+\sy@noderadius);
        \coordinate (\sy@name-south)  at (0,-\sy@nodetop-\sy@noderadius);
        \coordinate (\sy@name-northeast) at ( \sy@noderadius, \sy@nodetop+\sy@noderadius);
        \coordinate (\sy@name-northwest) at (-\sy@noderadius, \sy@nodetop+\sy@noderadius);
        \coordinate (\sy@name-southeast) at ( \sy@noderadius,-\sy@nodetop-\sy@noderadius);
        \coordinate (\sy@name-southwest) at (-\sy@noderadius,-\sy@nodetop-\sy@noderadius);

        \node[below=8pt, text centered] at (\sy@name-south)
            {\textcolor{black}{\bf \sy@caption}};
    },
    /synaplot/nodelayer/.search also={/tikz},
    /synaplot/nodelayer/.cd,
    count/.store       in=\sy@count,
    radius/.store      in=\sy@radius,
    spacing/.store     in=\sy@spacing,
    scale/.store       in=\sy@scale,
    fill/.store        in=\sy@fill,
    opacity/.store     in=\sy@opacity,
    caption/.store     in=\sy@caption,
    break/.store       in=\sy@break,
    name/.store        in=\sy@name,
    count=4,
    radius=1.6,
    spacing=5,
    scale=0.2,
    fill={rgb:blue,5;red,2.5;white,5},
    opacity=0.7,
    caption=,
    break=,
    name=,
}

\tikzset{
    FlatBlock/.pic={\tikzset{/synaplot/flatblock/.cd,#1}

        \pgfmathsetmacro{\sy@blockw}{\sy@width*\sy@scale}
        \pgfmathsetmacro{\sy@blockh}{\sy@height*\sy@scale}

        \node[rectangle, rounded corners=\sy@corner pt, draw, line width=0.3mm,
              fill=\sy@fill, fill opacity=\sy@opacity, text opacity=1,
              minimum width=\sy@blockw cm, minimum height=\sy@blockh cm,
              align=center, inner sep=2pt]
             (\sy@name-node) at (0,0) {\sy@text};

        \coordinate (\sy@name-anchor) at (0,0);
        \coordinate (\sy@name-west)   at (-\sy@blockw/2,0);
        \coordinate (\sy@name-east)   at ( \sy@blockw/2,0);
        \coordinate (\sy@name-north)  at (0, \sy@blockh/2);
        \coordinate (\sy@name-south)  at (0,-\sy@blockh/2);
        \coordinate (\sy@name-northeast) at ( \sy@blockw/2, \sy@blockh/2);
        \coordinate (\sy@name-northwest) at (-\sy@blockw/2, \sy@blockh/2);
        \coordinate (\sy@name-southeast) at ( \sy@blockw/2,-\sy@blockh/2);
        \coordinate (\sy@name-southwest) at (-\sy@blockw/2,-\sy@blockh/2);

        \ifx\sy@caption\@empty\else
            \node[below=8pt, text centered] at (\sy@name-south)
                {\textcolor{black}{\bf \sy@caption}};
        \fi
    },
    /synaplot/flatblock/.search also={/tikz},
    /synaplot/flatblock/.cd,
    width/.store       in=\sy@width,
    height/.store      in=\sy@height,
    scale/.store       in=\sy@scale,
    fill/.store        in=\sy@fill,
    opacity/.store     in=\sy@opacity,
    text/.store        in=\sy@text,
    caption/.store     in=\sy@caption,
    corner/.store      in=\sy@corner,
    name/.store        in=\sy@name,
    width=40,
    height=12,
    scale=0.2,
    fill={rgb:yellow,5;red,2.5;white,5},
    opacity=0.7,
    text=,
    caption=,
    corner=3,
    name=,
}
\makeatother
