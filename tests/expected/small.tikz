\coordinate (syBaseline1) at (0,-6.64);

\pic[shift={(0,0,0)}] at (0,0,0)
    {Box={
        name=conv1,
        fill=\syColorConv,
        opacity=0.4,
        height=40.0,
        width=1,
        depth=40.0,
        xlabel={{"64",""}},
        zlabel=512,
        caption=conv1,
        baseline=syBaseline1
    }};

\pic[shift={(1.6,0,0)}] at (conv1-east)
    {Box={
        name=pool1,
        fill=\syColorPool,
        opacity=0.5,
        height=32.0,
        width=1,
        depth=32.0,
        baseline=syBaseline1
    }};

\pic[shift={(1.6,0,0)}] at (pool1-east)
    {RightBandedBox={
        name=conv2,
        fill=\syColorConv,
        opacity=0.4,
        height=30.0,
        width={3,3,3},
        depth=30.0,
        xlabel={{"128","128","128"}},
        zlabel=256,
        bandfill=\syColorConvRelu,
        bandopacity=0.6,
        baseline=syBaseline1
    }};

\pic[shift={(1.6,0,0)}] at (conv2-east)
    {Box={
        name=out,
        fill=\syColorSoftmax,
        opacity=0.8,
        height=3.0,
        width=1.5,
        depth=25.0,
        zlabel=10,
        caption=softmax,
        baseline=syBaseline1
    }};

\pic[shift={(1.6,0,0)}] at (out-east)
    {Ball={
        name=add1,
        fill=\syColorSum,
        opacity=0.6,
        radius=2.5,
        logo=$+$,
        baseline=syBaseline1
    }};

\draw [syConnection] (conv1-east) -- node {\syArrow} (pool1-west);

\draw [syConnection] (pool1-east) -- node {\syArrow} (conv2-west);

\draw [syConnection] (conv2-east) -- node {\syArrow} (out-west);

\draw [syConnection] (out-east) -- node {\syArrow} (add1-west);

\coordinate (conv1-out-roof-conv1) at (conv1-north |- 0,5);
\coordinate (conv1-out-roof-out) at (out-north |- 0,5);
\draw [syCopyConnection] (conv1-north) -- (conv1-out-roof-conv1)
    -- node[near end] {\syCopyArrow} (conv1-out-roof-out) -- (out-north);
